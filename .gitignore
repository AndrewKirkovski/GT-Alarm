# Work docs and temp outputs (global rule — user CLAUDE.md)
.local/
.cache/
.kotlin/

# Collected release artifacts (scripts/collect-release.sh copies the signed
# APK/AAB/.app here with version-stamped names). Binaries — never committed.
/dist/

# Local scratch + regeneratable icon previews (the *.svg sources ARE tracked;
# the *.generated.png are produced from them by gen-app-icons.py).
/tmp/
/screens/
/*.generated.png

# OS
.DS_Store
Thumbs.db
desktop.ini
*.stackdump

# Editors
.idea/
.vscode/
*.iml
*.swp
*.swo

# =========================
# Android (android-app/)
# =========================
android-app/.gradle/
android-app/build/
android-app/app/build/
android-app/captures/
android-app/local.properties
android-app/.cxx/
android-app/app/.cxx/
android-app/app/release/
android-app/app/debug/
android-app/**/*.apk
android-app/**/*.aab
android-app/**/*.ap_
android-app/**/*.dex
android-app/**/*.class

# Keystores (commit signing config via env, not keystores)
android-app/**/*.jks
android-app/**/*.keystore
android-app/keystore.properties
android-app/**/keystore.properties

# AGConnect services config — bundles app/project IDs and (if "Include key"
# was selected on download) client_secret + API key. Default to gitignored
# to avoid committing the keyed variant. The team can share the file out-of-band
# (Drive / 1Password) until we agree which variant is repo-safe.
android-app/app/agconnect-services.json

# Gradle wrapper binary is committed; lock file cache is not
android-app/.gradle/**

# =========================
# DevEco / HarmonyOS — live watch-app/
# =========================
watch-app/build/
watch-app/**/build/
watch-app/**/.hvigor/
watch-app/**/.cxx/
watch-app/**/.test/
watch-app/oh_modules/
watch-app/**/oh_modules/
watch-app/**/.cache/
watch-app/**/.preview/
watch-app/**/*.hap
watch-app/**/*.app
watch-app/**/*.hsp
watch-app/**/*.har
watch-app/local.properties
watch-app/**/local.properties

# =========================
# DevEco / HarmonyOS — legacy watch-app.old/
# Kept around as reference during the LiteWearable rewrite (Phase 0b).
# Same patterns as above; intentionally not collapsed because gitignore
# patterns don't support brace expansion.
# =========================
watch-app.old/build/
watch-app.old/**/build/
watch-app.old/**/.hvigor/
watch-app.old/**/.cxx/
watch-app.old/**/.test/
watch-app.old/oh_modules/
watch-app.old/**/oh_modules/
watch-app.old/**/.cache/
watch-app.old/**/.preview/
watch-app.old/**/*.hap
watch-app.old/**/*.app
watch-app.old/**/*.hsp
watch-app.old/**/*.har
watch-app.old/local.properties
watch-app.old/**/local.properties

# DevEco signing — covers project root + watch-app subtree (CSRs, certs,
# profiles, keystores can land in either location depending on DevEco
# Automatic-Signing flow)
*.p12
*.cer
*.csr
*.p7b
*.pem
*.jks
*.keystore

# Node (DevEco uses node internally)
node_modules/

# JVM crash dumps from Gradle daemon OOM (CLAUDE.md mitigations)
android-app/**/hs_err_*.log
android-app/**/replay_*.log

# Per-machine Claude Code state (settings.local.json, scheduled-tasks lock, etc.)
.claude/

# MCP server configuration — contains API keys (Recraft, etc.)
.mcp.json

# APK safety net. Every APK in this tree is a build output (dist/, android-app/
# build outputs, meta/site/public/apk/). A stray 5.5 MB binary committed to a
# public repo cannot be removed without rewriting history.
*.apk
