<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- maxSdkVersion="32" mirrors Fossify Clock: USE_EXACT_ALARM (API 33+)
         supersedes SCHEDULE_EXACT_ALARM, but Play policy still wants
         SCHEDULE_EXACT_ALARM declared for API 32 and below. Capping it
         avoids the runtime-grant nag flow on Android 14. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- FGS type bumped from mediaPlayback to specialUse 2026-05-13: Fossify
         Clock (only Android-14+ targeting reference alarm app) uses
         specialUse + PROPERTY_SPECIAL_USE_FGS_SUBTYPE. mediaPlayback was
         valid but not the documented choice for alarm rings. We declare
         BOTH because minSdk=31 — FOREGROUND_SERVICE_SPECIAL_USE was added
         in API 34; on API 31-33 the OS uses mediaPlayback (the service
         declares both via foregroundServiceType="specialUse|mediaPlayback"
         and code picks the right runtime int based on Build.VERSION). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Alarm-clock-category exemption from Google Play's REQUEST_IGNORE_BATTERY
         restriction; deep-links to the OS dialog so One UI doesn't deep-sleep us. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Wear Engine has no <uses-permission> — runtime-only via
         HiWear.getAuthClient(...).requestPermission(DEVICE_MANAGER). -->

    <!-- Android 11+ package-visibility queries: SET_ALARM resolves alarm-app
         handlers; com.huawei.health is the documented Wear Engine bridge on
         non-Huawei phones (Samsung). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <package android:name="com.huawei.health" />
    </queries>

    <application
        android:name=".GtAlarmApp"
        android:allowBackup="false"
        android:appCategory="productivity"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GtAlarm"
        tools:targetApi="34">

        <!-- Phone-side AGConnect appid (the watch HAP has its own separate
             entry under the Sports Watch / Lite Wearable track). Manually
             declared because `agcp { manifest = false }` (AGP 9 compat) skips
             auto-injection. Value MUST match client.app_id in
             agconnect-services.json. Format: `appid=<numeric_id>`. -->
        <meta-data
            android:name="com.huawei.hms.client.appid"
            android:value="${agconnectAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GtAlarm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- taskAffinity="" (empty string) keeps AlarmActivity in its own task
             so it can't be shoved behind a recent MainActivity when fired from
             a lock screen, and FLAG_ACTIVITY_NEW_TASK lands on a fresh stack
             every time. resizeableActivity=false avoids being squeezed into a
             window on Samsung DeX. -->
        <activity
            android:name=".ring.AlarmActivity"
            android:directBootAware="true"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true"
            android:theme="@style/Theme.GtAlarm.Fullscreen" />

        <activity
            android:name=".voice.AddAlarmShimActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- FGS type = specialUse|mediaPlayback. specialUse is the documented
             choice for Android-14+ alarm rings (per Fossify Clock); the |
             mediaPlayback is the fallback for API 31-33 where SPECIAL_USE
             didn't exist. PROPERTY_SPECIAL_USE_FGS_SUBTYPE is mandated by
             Google Play for the specialUse FGS path. -->
        <service
            android:name=".ring.AlarmRingService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaPlayback">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Plays the alarm tone and shows the ringing UI when a scheduled alarm fires" />
        </service>

        <receiver
            android:name=".scheduler.AlarmBroadcastReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name=".scheduler.BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.NextAlarmWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glance_alarm_widget_info" />
        </receiver>

    </application>
</manifest>
