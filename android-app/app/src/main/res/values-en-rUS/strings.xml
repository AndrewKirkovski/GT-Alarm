    <string name="action_open_help">Help</string>
    <string name="screen_help_title">Voice setup</string>
    <string name="help_intro">Android doesn\'t have a single setting called \"default alarm app\". When you ask Google Assistant to set an alarm, the system either uses an app you\'ve picked before, or shows a chooser the first time. Choosing GT Alarm and tapping \"Always\" makes it the default thereafter.</string>
    <string name="help_status_default">GT Alarm is the default alarm app on this device.</string>
    <string name="help_status_disambiguator">Multiple alarm apps are installed. The next time you say \"Hey Google, set an alarm\", Android will show a chooser — pick GT Alarm and tap Always.</string>
    <string name="help_status_other">%1$s is currently the default. Use the steps for your phone brand below to switch.</string>
    <string name="help_status_none">No alarm app is registered on this device. Try reinstalling GT Alarm.</string>
    <string name="help_open_default_apps">Open Default apps in Settings</string>
    <string name="help_reset_hint">If a different app got set as default by mistake: Settings → Apps → that app → Open by default → Clear defaults.</string>
    <string name="help_pair_watch_title">Authorize Huawei watch</string>
    <string name="help_pair_watch_body">Authorize Wear Engine access so alarms can ring on a Huawei Sports Watch / GT-series device that is already paired through Huawei Health. Requires the Huawei Health app; nothing happens on devices without it.</string>
    <string name="help_pair_watch_button">Authorize watch access</string>
    <string name="help_donate_title">Support development</string>
    <string name="help_donate_body">GT Alarm is free and ad-free. If it\'s saving your mornings, consider buying me a coffee — it directly funds time spent on features and device support.</string>
    <string name="help_donate_button">Buy me a coffee</string>
    <string name="help_device_unsupported_title">Different watch?</string>
    <string name="help_device_unsupported_body">Only Huawei GT 6 Pro is fully tested today. If your watch model isn\'t syncing or the layout looks wrong, drop me a line — donating a device for testing is the fastest way to add proper support.</string>
    <string name="help_device_unsupported_button">Contact developer</string>
