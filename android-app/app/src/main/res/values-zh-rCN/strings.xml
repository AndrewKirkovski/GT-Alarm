    <string name="setup_perm_notifications_title">通知</string>
    <string name="setup_perm_notifications_body">允许显示响铃闹钟通知。Android 13 及以上版本会在运行时请求此权限。</string>
    <string name="setup_perm_exact_alarm_title">闹钟和提醒</string>
    <string name="setup_perm_exact_alarm_body">允许使用精确闹钟定时，而非大致的后台调度。如果关闭，已安排的闹钟将不可靠。</string>
    <string name="setup_perm_fsi_title">全屏闹钟</string>
    <string name="setup_perm_fsi_body">允许闹钟界面在锁屏上方显示。如果开启后仍保持关闭，请联系开发者。</string>
    <string name="setup_perm_battery_title">电池：无限制</string>
    <string name="setup_perm_battery_body">可选。仅在必需项检查通过后闹钟仍延迟时再尝试。</string>

