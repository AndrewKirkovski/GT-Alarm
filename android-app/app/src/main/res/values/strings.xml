    <!-- Section header texts. -->
    <string tools:ignore="MissingTranslation" name="help_section_reliability">Reliability checklist</string>
    <string tools:ignore="MissingTranslation" name="help_section_reliability_intro">For alarms to ring while your phone is locked, all of the items below need to be green. Tap Fix on anything that isn\'t.</string>
    <string tools:ignore="MissingTranslation" name="help_section_brand_tips">Phone-brand tips</string>
    <string tools:ignore="MissingTranslation" name="help_section_brand_tips_intro">Some manufacturers add their own background-killers and voice quirks on top of Android. The reliability checks above cover the universal toggles; the steps below are the per-brand bits.</string>
    <string tools:ignore="MissingTranslation" name="help_subsection_keep_awake">Keep the app awake</string>
    <string tools:ignore="MissingTranslation" name="help_subsection_voice">Voice (Hey Google)</string>

    <!-- Home-screen banner that auto-shows when any reliability check is red. -->
    <string tools:ignore="MissingTranslation" name="setup_banner_title">Setup needed</string>
    <string tools:ignore="MissingTranslation" name="setup_banner_body">One or more required permissions are missing. Alarms may not ring or wake the screen until they\'re granted.</string>
    <string tools:ignore="MissingTranslation" name="setup_banner_action">Open</string>
    <string tools:ignore="MissingTranslation" name="setup_fix">Fix</string>

    <!-- Permission rows. Each is short — one purpose, one consequence. -->
    <string tools:ignore="MissingTranslation" name="setup_perm_notifications_title">Notifications</string>
    <string tools:ignore="MissingTranslation" name="setup_perm_notifications_body">Required to post the ringing notification and run the alarm in the foreground. Without this the alarm cannot ring.</string>
    <string tools:ignore="MissingTranslation" name="setup_perm_exact_alarm_title">Alarms &amp; reminders</string>
    <string tools:ignore="MissingTranslation" name="setup_perm_exact_alarm_body">Lets the app fire alarms at the exact minute you set, even in battery-saver mode. Denied by default on Android 14.</string>
    <string tools:ignore="MissingTranslation" name="setup_perm_fsi_title">Full-screen alarm</string>
    <string tools:ignore="MissingTranslation" name="setup_perm_fsi_body">Lets the alarm take over the lock screen and wake the display. Sideloaded apps lose this auto-grant on Android 14 — if your phone screen does not wake when alarms fire, this is almost certainly the cause.</string>
    <string tools:ignore="MissingTranslation" name="setup_perm_battery_title">Battery: Unrestricted</string>
    <string tools:ignore="MissingTranslation" name="setup_perm_battery_body">Optional but recommended. Without it the phone may delay alarms after several idle days. Daily users rarely notice — alarms scheduled via setAlarmClock() are Doze-exempt regardless.</string>

