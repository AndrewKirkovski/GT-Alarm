    <string tools:ignore="MissingTranslation" name="setup_perm_exact_alarm_title">Alarms &amp; reminders</string>
    <string tools:ignore="MissingTranslation" name="setup_perm_exact_alarm_body">Allows alarm-clock timing instead of approximate background work. If this is off, scheduled alarms are not trustworthy.</string>
    <string tools:ignore="MissingTranslation" name="setup_perm_fsi_title">Full-screen alarm</string>
