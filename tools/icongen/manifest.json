      "stroke-nav": ["#009EDA", "#6373F2"],
      "fill-green": ["#1EA52C", "#4ADE80"],
      "fill-orange": ["#DE6D23", "#FB923C"],
      "fill-violet": ["#EC85DE", "#E058CE"]
    }
  },
