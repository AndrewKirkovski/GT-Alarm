<!-- Single-page watch UI. Three screens — list / sync / ring — are
     mutually-exclusive `if=`-rendered blocks switched by the `screen`
     data field. No router: one page, one bundle, one P2P receiver. -->
<stack class="root">

    <!-- ================= LIST screen ================= -->
    <!-- Each screen is its own <stack> with a full-screen background
         <image> as the bottom layer. A bg <image> placed directly under
         the ROOT <stack> did NOT render; the ring stack proves a NESTED
         <stack> composites a layer behind its content. -->
    <stack class="screen" if="{{screen === 'list'}}">
        <image class="bg-full" src="{{bgSrc}}" if="{{hasBg}}"></image>
        <div class="scrim" if="{{showScrim}}"></div>
        <div class="content">
        <text class="title">{{title}}</text>
        <text class="diag-line">{{diagLine2}}</text>
        <text class="diag-line">{{bgDiag}}</text>

        <list class="alarm-list" ref="alarmList" if="{{alarms.length > 0}}">
            <list-item class="alarm-list-row" for="{{alarms}}" tid="id"
                       onclick="onRowTap({{$item.id}})">
                <div class="alarm-row" if="{{$item.enabled}}">
                    <div class="status-dot"></div>
                    <text class="alarm-time">{{$item.time}}</text>
                    <div class="alarm-days-grid" if="{{$item.isRecurring}}">
                        <div class="day-cell">
                            <text class="day-cell-letter">{{$item.dL0}}</text>
                            <div class="day-dot-on" if="{{$item.d0On}}"></div>
                            <div class="day-dot" if="{{$item.d0Off}}"></div>
                        </div>
                        <div class="day-cell">
                            <text class="day-cell-letter">{{$item.dL1}}</text>
                            <div class="day-dot-on" if="{{$item.d1On}}"></div>
                            <div class="day-dot" if="{{$item.d1Off}}"></div>
                        </div>
                        <div class="day-cell">
                            <text class="day-cell-letter">{{$item.dL2}}</text>
                            <div class="day-dot-on" if="{{$item.d2On}}"></div>
                            <div class="day-dot" if="{{$item.d2Off}}"></div>
                        </div>
                        <div class="day-cell">
                            <text class="day-cell-letter">{{$item.dL3}}</text>
                            <div class="day-dot-on" if="{{$item.d3On}}"></div>
                            <div class="day-dot" if="{{$item.d3Off}}"></div>
                        </div>
                        <div class="day-cell">
                            <text class="day-cell-letter">{{$item.dL4}}</text>
                            <div class="day-dot-on" if="{{$item.d4On}}"></div>
                            <div class="day-dot" if="{{$item.d4Off}}"></div>
                        </div>
                        <div class="day-cell">
                            <text class="day-cell-letter">{{$item.dL5}}</text>
                            <div class="day-dot-on" if="{{$item.d5On}}"></div>
                            <div class="day-dot" if="{{$item.d5Off}}"></div>
                        </div>
                        <div class="day-cell">
                            <text class="day-cell-letter">{{$item.dL6}}</text>
                            <div class="day-dot-on" if="{{$item.d6On}}"></div>
                            <div class="day-dot" if="{{$item.d6Off}}"></div>
                        </div>
                    </div>
                    <text class="alarm-days-text" if="{{$item.isNotRecurring}}">{{$item.daysText}}</text>
                </div>
                <div class="alarm-row-dim" if="{{$item.notEnabled}}">
                    <div class="status-dot-off"></div>
                    <text class="alarm-time-dim">{{$item.time}}</text>
                    <div class="alarm-days-grid" if="{{$item.isRecurring}}">
                        <div class="day-cell">
                            <text class="day-cell-letter-dim">{{$item.dL0}}</text>
                            <div class="day-dot-on-dim" if="{{$item.d0On}}"></div>
                            <div class="day-dot" if="{{$item.d0Off}}"></div>
                        </div>
                        <div class="day-cell">
                            <text class="day-cell-letter-dim">{{$item.dL1}}</text>
                            <div class="day-dot-on-dim" if="{{$item.d1On}}"></div>
                            <div class="day-dot" if="{{$item.d1Off}}"></div>
                        </div>
                        <div class="day-cell">
                            <text class="day-cell-letter-dim">{{$item.dL2}}</text>
                            <div class="day-dot-on-dim" if="{{$item.d2On}}"></div>
                            <div class="day-dot" if="{{$item.d2Off}}"></div>
                        </div>
                        <div class="day-cell">
                            <text class="day-cell-letter-dim">{{$item.dL3}}</text>
                            <div class="day-dot-on-dim" if="{{$item.d3On}}"></div>
                            <div class="day-dot" if="{{$item.d3Off}}"></div>
                        </div>
                        <div class="day-cell">
                            <text class="day-cell-letter-dim">{{$item.dL4}}</text>
                            <div class="day-dot-on-dim" if="{{$item.d4On}}"></div>
                            <div class="day-dot" if="{{$item.d4Off}}"></div>
                        </div>
                        <div class="day-cell">
                            <text class="day-cell-letter-dim">{{$item.dL5}}</text>
                            <div class="day-dot-on-dim" if="{{$item.d5On}}"></div>
                            <div class="day-dot" if="{{$item.d5Off}}"></div>
                        </div>
                        <div class="day-cell">
                            <text class="day-cell-letter-dim">{{$item.dL6}}</text>
                            <div class="day-dot-on-dim" if="{{$item.d6On}}"></div>
                            <div class="day-dot" if="{{$item.d6Off}}"></div>
                        </div>
                    </div>
                    <text class="alarm-days-text-dim" if="{{$item.isNotRecurring}}">{{$item.daysText}}</text>
                </div>
            </list-item>
        </list>

        <div class="empty" if="{{alarms.length === 0}}">
            <text class="empty-title">{{emptyText}}</text>
            <text class="empty-hint">{{emptyHint}}</text>
        </div>
        </div>
        <!-- Tap hint — overlay shown when a row is tapped (alarms are
             edited on the phone, not the watch). Top layer of the stack. -->
        <div class="tap-hint" if="{{tapHintShown}}">
            <text class="tap-hint-text">{{tapHint}}</text>
        </div>
    </stack>

    <!-- ================= SYNC screen ================= -->
    <stack class="screen" if="{{screen === 'sync'}}">
        <image class="bg-full" src="{{bgSrc}}" if="{{hasBg}}"></image>
        <div class="scrim" if="{{showScrim}}"></div>
        <div class="content">
            <text class="title">{{syncTitle}}</text>
            <text class="sync-sub">{{syncSubtitle}}</text>
            <text class="live-line">{{liveLine}}</text>
            <text class="diag-line">{{diagLine1}}</text>
            <text class="diag-line">{{diagLine2}}</text>
        </div>
    </stack>

    <!-- ================= RING screen ================= -->
    <stack class="ring" if="{{screen === 'ring'}}" onswipe="onSwipe">
        <!-- Hidden, always-scrollable list: the digital crown scrolls the
             focused <list>, so this one turns the crown into scrollend
             ticks (crown-to-snooze). Bottom layer + transparent =
             invisible, and never intercepts touch from the buttons. -->
        <list class="crown-list" ref="crownList" onscrollend="onCrownTick">
            <list-item class="crown-item" for="{{crownItems}}">
                <div class="crown-cell"></div>
            </list-item>
        </list>
        <image class="bg-full" src="{{bgSrc}}" if="{{hasBg}}"></image>
        <progress type="arc" percent="100" class="ring-arc" if="{{!ended}}"></progress>
        <progress type="arc" percent="100" class="ring-arc-green" if="{{ended}}"></progress>
        <div class="ring-content">
            <image src="common/bell.png" class="ring-bell"></image>
            <text class="ring-title">{{ringTitle}}</text>
            <text class="ring-time">{{ringTime}}</text>
            <!-- Action row: snooze + stop when snoozable, stop-only when
                 the alarm has snoozeMinutes=0, OR the green thumbs-up
                 confirmation once ended. SAME Y position via identical
                 width/height/margin on all three slots. -->
            <div class="ring-actions" if="{{!ended && ringSnoozeEnabled}}">
                <div class="ring-btn" onclick="onSnooze">
                    <image src="common/snooze.png" class="ring-btn-img"></image>
                </div>
                <div class="ring-btn" onclick="onDismiss">
                    <image src="common/stop.png" class="ring-btn-img"></image>
                </div>
            </div>
            <div class="ring-actions-stop" if="{{!ended && !ringSnoozeEnabled}}">
                <div class="ring-btn" onclick="onDismiss">
                    <image src="common/stop.png" class="ring-btn-img"></image>
                </div>
            </div>
            <div class="ring-ended" if="{{ended}}">
                <image src="common/thumbup.png" class="ring-thumb"></image>
            </div>
            <text class="ring-diag">{{ringDiagText}}</text>
        </div>
    </stack>

</stack>
